          "rawQuery": true,
          "rawSql": "select\r\n  \"time\",\r\n  max(share) filter (where region = 'russia_ukraine') * 100 as \"Russia/Ukraine\",\r\n  max(share) filter (where region = 'china_taiwan') * 100  as \"China/Taiwan\",\r\n  max(share) filter (where region = 'middle_east') * 100   as \"Middle East\"\r\nfrom (\r\n  select\r\n    day as \"time\",\r\n    region,\r\n    avg(material_conflict::float / nullif(events, 0))\r\n      over (partition by region order by day rows between 6 preceding and current row) as share\r\n  from gdelt_daily\r\n  where region <> 'global'\r\n) t\r\nwhere $__timeFilter(\"time\")\r\ngroup by \"time\"\r\norder by \"time\"\r\n",
